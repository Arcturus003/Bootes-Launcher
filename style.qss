/* Nexus Client Theme (Modernized UI/UX) */

QMainWindow {
    background-color: #171615;
}

QWidget {
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    color: #E0E0E0;
}

/* Left Navigation Bar */
#NavBar {
    background-color: rgba(20, 20, 25, 0.95);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
}

#NavButton {
    background-color: transparent;
    border: none;
    padding: 10px 15px;
    font-size: 18px;
    font-weight: bold;
    text-align: left;
    color: #888888;
    border-radius: 8px;
    margin: 5px;
}

#NavButton:hover {
    color: #40E0D0;
    background-color: rgba(64, 224, 208, 0.1);
}

#NavButton[active="true"] {
    color: #40E0D0;
    background-color: rgba(64, 224, 208, 0.15);
    border-left: 4px solid #40E0D0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

/* Action Bar (Bottom) */
#ActionBar {
    background-color: rgba(15, 15, 20, 0.98);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

#PlayButton {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #1B9C96, stop: 1 #40E0D0);
    color: #0A0A0A;
    font-size: 22px;
    font-weight: 800;
    border-radius: 12px;
    padding: 10px 50px;
    border: none;
}

#PlayButton:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #28D5CC, stop: 1 #60EFE1);
}

#PlayButton:pressed {
    background: #178A85;
}

#PlayButton:disabled {
    background: #333333;
    color: #666666;
}

/* Profiles List */
QListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    background-color: rgba(30, 30, 35, 0.6);
    border-radius: 8px;
    margin-bottom: 8px;
    padding: 4px;
    border: 1px solid transparent;
}

QListWidget::item:hover {
    background-color: rgba(45, 45, 55, 0.8);
    border: 1px solid rgba(64, 224, 208, 0.3);
}

QListWidget::item:selected {
    background-color: rgba(64, 224, 208, 0.15);
    border: 1px solid #40E0D0;
}

/* Cards (Modrinth Browser) */
#ModpackCard {
    background-color: rgba(30, 30, 35, 0.8);
    border: 1px solid #333333;
    border-radius: 12px;
}

#ModpackCard:hover {
    border: 1px solid #40E0D0;
    background-color: rgba(40, 40, 45, 0.9);
}

#CardTitle {
    font-size: 16px;
    font-weight: bold;
    color: #FFFFFF;
}

#CardSubtitle {
    font-size: 12px;
    color: #AAAAAA;
}

/* Right Detail Panel */
#DetailPanel {
    background-color: rgba(20, 20, 25, 0.95);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox {
    background-color: rgba(0, 0, 0, 0.4);
    border: 1px solid #444;
    border-radius: 6px;
    padding: 8px 12px;
    color: white;
    font-size: 14px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #40E0D0;
    background-color: rgba(0, 0, 0, 0.6);
}

/* Buttons */
QPushButton {
    background-color: rgba(50, 50, 55, 0.9);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: rgba(70, 70, 75, 1);
    border: 1px solid #40E0D0;
}
QPushButton:pressed {
    background-color: rgba(40, 40, 45, 1);
}

/* Scrollbars */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    border-radius: 3px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background: #40E0D0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Progress Bar */
QProgressBar {
    background-color: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #1B9C96, stop: 1 #40E0D0);
    border-radius: 5px;
}

/* Menus & Dialogs */
QDialog {
    background-color: #171615;
}
QMenu { 
    background-color: #1F1F24; 
    color: white; 
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
}
QMenu::item { 
    padding: 8px 25px; 
    border-radius: 4px;
    margin: 2px 4px;
}
QMenu::item:selected { 
    background-color: rgba(64, 224, 208, 0.15); 
    color: #40E0D0; 
}
